{
  "name": "jemma-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm images && vite dev --host 127.0.0.1 --port 3001 --strictPort",
    "build": "pnpm images && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3001 --strictPort",
    "start": "pnpm preview",
    "deploy": "pnpm build && wrangler deploy --profile personal",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "check": "pnpm typecheck && pnpm lint",
    "images": "node scripts/generate-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.0.0-rc17",
    "lucide-react": "^0.563.0",
    "motion": "^12.29.0",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@eslint/js": "^9.31.0",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "^0.7.0",
    "eslint": "^9.31.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.1.6",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
